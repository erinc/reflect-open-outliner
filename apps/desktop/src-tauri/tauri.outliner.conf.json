{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reflect Outliner",
  "mainBinaryName": "reflect-outliner",
  "identifier": "app.reflect.desktop.outliner",
  "build": {
    "beforeDevCommand": "pnpm sidecar && pnpm dev --mode outliner",
    "beforeBuildCommand": "pnpm sidecar && pnpm build --mode outliner"
  },
  "app": {
    "windows": [
      {
        "title": "Reflect Outliner",
        "width": 1300,
        "height": 650,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "icon": [
      "icons-dev/32x32.png",
      "icons-dev/128x128.png",
      "icons-dev/128x128@2x.png",
      "icons-dev/icon.icns",
      "icons-dev/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.dev.plist",
      "infoPlist": "Info.outliner.plist",
      "files": {
        "embedded.provisionprofile": null
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["reflect-outliner"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/erinc/reflect-open-outliner/releases/download/updater-outliner-noop/latest.json"
      ]
    }
  }
}
